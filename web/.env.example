# Newsletter — SendGrid Marketing Campaigns.
# SENDGRID_API_KEY is server-only on purpose: anything prefixed NEXT_PUBLIC_ is
# readable by every visitor, so the key must never carry that prefix.
SENDGRID_API_KEY=
# Marketing > Contacts > your list > the id in the URL
SENDGRID_LIST_ID=
# Optional welcome email. Needs a Dynamic Template id and a verified sender.
SENDGRID_WELCOME_TEMPLATE_ID=
SENDGRID_FROM=hello@cryptoslotguide.com
# Optional: Suppressions > Unsubscribe Groups. Without one, unsubscribes fall back
# to SendGrid's global suppression list.
SENDGRID_UNSUBSCRIBE_GROUP_ID=

# Flips the sign-up button from "Opens at launch" to live. Set to 1 once the
# three required values above are filled in.
NEXT_PUBLIC_NEWSLETTER_ON=

# Optional: shows the "message us" box on the jurisdiction pages.
NEXT_PUBLIC_TELEGRAM_URL=
# Canonical URL used in metadata and the sitemap.
NEXT_PUBLIC_SITE_URL=https://cryptoslotguide.com
